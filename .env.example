# Application database connection. Connects as a NON-superuser role that is
# subject to row-level security. All feature code uses this connection.
DATABASE_URL=postgresql://wfb_app:wfb_app@localhost:5432/wfb_test

# Administrative connection used ONLY for migrations and schema introspection
# tests. Connects as a privileged role. Never used by feature code.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/wfb_test

# Anthropic API key, used only by the semantic tool layer in packages/ai.
ANTHROPIC_API_KEY=
